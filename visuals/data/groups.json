  "help": {
    "gfx-comp": {
      "thresh": "Level above which the compressor starts to reduce gain",
      "attack": "How fast gain reduction sets in once the level exceeds the threshold",
      "ratio": "How much the level above the threshold is reduced (30:1 ≈ limiting)",
      "character": "The compressor's voicing: clean, bus glue, FET, opto or pedal"
    },
    "gfx-eq": {
      "mid2freq": "Centre frequency of the second mid band",
      "airfreq": "Corner frequency of the air shelf",
      "harsh_freq": "Centre of the band the de-harsher watches and tames",
      "output": "Output level after the EQ",
      "lowcut": "High-pass filter: removes the lows below this frequency",
      "midgain": "Boost or cut of the mid bell",
      "lowcut_slope": "Steepness of the low cut (Butterworth)",
      "harsh_range": "Maximum cut the de-harsher may apply"
    },
    "gfx-deesser": {
      "shape": "How the sibilance is cut: high shelf, narrow bell or wide band"
    },
    "gfx-wah": {
      "model": "The wah circuit whose sweep, Q and voicing are played",
      "mix": "Wet level against the dry signal (100 % = wah only)",
      "mode": "Manual = the pedal sweeps; auto = the envelope sweeps; alien = both",
      "taper": "How the pedal travel maps onto the sweep; Model = the circuit's own pot",
      "toe": "Where the sweep ends at toe down (percent of the full range)",
      "auto_engage": "Switches the wah on when the pedal moves, off when it rests at heel",
      "engage_wait": "How long the pedal must rest at heel before the wah switches off",
      "env_sens": "How strongly playing dynamics move the sweep (auto and alien modes)",
      "env_att": "How fast the envelope follows a louder note",
      "env_rel": "How fast the envelope falls back after the note"
    },
    "gfx-autowah": {
      "poles": "Filter slope: 2 poles = vocal, 4 poles = deeper, synth-like",
      "direction": "Up = louder notes sweep upward; Down = they sweep downward",
      "low": "Bottom of the sweep",
      "high": "Top of the sweep",
      "attack": "How fast the sweep follows a picked note",
      "release": "How fast the sweep falls back after the note",
      "mix": "Wet level against the dry signal (100 % = filter only)",
      "source": "What moves the filter: playing dynamics, an LFO, sample and hold, or both",
      "sync": "Locks the LFO to the host tempo; Off = the Rate control",
      "peak": "Resonance of the filter: higher = a sharper, more vocal peak",
      "rate": "Speed of the LFO or sample-and-hold source"
    },
    "gfx-tremolo": {
      "rate": "Speed of the volume modulation (when Sync is Off)",
      "model": "The tremolo circuit: clean VCA, valve bias, optical cell, neon or harmonic (two bands in opposition)",
      "sync": "Locks the rate to the host tempo; Off = the Rate control",
