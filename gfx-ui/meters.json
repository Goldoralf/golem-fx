{
  "_": [
    "How the editor shows each plugin's read-only meters, under the pedal (gfx-ui/README.md §6). Read by",
    "visuals/tools/build-ui.js, which fails on a meter of the descriptor that is neither shown nor hidden.",
    "One row per entry, in this order. kind:",
    "  gr      a reduction in dB (>= 0), a bar over 0..max",
    "  bar     a bar over min..max; center: true fills from the middle (a signed value)",
    "  lamp    a lamp lit while the value is >= 0.5",
    "  state   the value as an index into states, the lamp lit past the first state",
    "  value   the plugin's own text of the value; format: midi shows a note name (0 = none)",
    "  bands   several signed meters side by side (ids, labels), over -max..max",
    "hide: meters left out (counters and witnesses kept for golem, not for a player)."
  ],
  "gfx-gate":        { "rows": [{ "id": "state", "kind": "lamp", "label": "Open" },
                                { "id": "gr", "kind": "gr", "label": "Reduction", "max": 60 }] },
  "gfx-met":         { "rows": [{ "id": "state", "kind": "lamp", "label": "Open" },
                                { "id": "gr", "kind": "gr", "label": "Reduction", "max": 60 }] },
  "gfx-comp":        { "rows": [{ "id": "gr", "kind": "gr", "label": "Reduction", "max": 24 }] },
  "gfx-limiter":     { "rows": [{ "id": "gr", "kind": "gr", "label": "Reduction", "max": 24 }] },
  "gfx-eq":          { "rows": [{ "id": "harsh_gr", "kind": "gr", "label": "De-harsh", "max": 12 }] },
  "gfx-deesser":     { "rows": [{ "id": "gr", "kind": "gr", "label": "Reduction", "max": 24 }] },
  "gfx-killswitch":  { "rows": [], "hide": ["steps_count", "picks_count"] },
  "gfx-golem":       { "rows": [{ "id": "state", "kind": "state", "label": "Voice", "states": ["Idle", "Tracking", "Gated"] }] },
  "gfx-swell":       { "rows": [{ "id": "state", "kind": "state", "label": "Swell", "states": ["Idle", "Rise", "Hold", "Decay"] },
                                { "id": "gr", "kind": "gr", "label": "Reduction", "max": 60 }],
                       "hide": ["onsets_count"] },
  "gfx-crusher":     { "rows": [{ "id": "rate_out", "kind": "value", "label": "Rate now" }] },
  "gfx-ringmod":     { "rows": [{ "id": "state", "kind": "state", "label": "Tracking", "states": ["Free", "Tracking", "Locked"] },
                                { "id": "carrier_hz", "kind": "value", "label": "Carrier" }] },
  "gfx-bassdi":      { "rows": [{ "id": "gr", "kind": "gr", "label": "Comp", "max": 30 }] },
  "gfx-tape":        { "rows": [{ "id": "wf_out", "kind": "bar", "label": "Wow & flutter", "min": 0, "max": 2 }] },
  "gfx-transient":   { "rows": [{ "id": "shaping", "kind": "bar", "label": "Shaping", "min": -24, "max": 24, "center": true },
                                { "id": "gr", "kind": "gr", "label": "Ceiling", "max": 24 }] },
  "gfx-mbcomp":      { "rows": [{ "id": "gr", "kind": "gr", "label": "Reduction", "max": 24 },
                                { "kind": "bands", "label": "Bands", "ids": ["lo_dyn", "lm_dyn", "hm_dyn", "hi_dyn"],
                                  "labels": ["Low", "Lo mid", "Hi mid", "High"], "max": 12 }] },
  "gfx-widener":     { "rows": [{ "id": "corr", "kind": "bar", "label": "Correlation", "min": -1, "max": 1, "center": true },
                                { "id": "mono_err", "kind": "value", "label": "Mono error" }] },
  "gfx-ducker":      { "rows": [{ "id": "gr", "kind": "gr", "label": "Duck", "max": 30 }], "hide": ["state"] },
  "gfx-fuzz":        { "rows": [{ "id": "bias_v", "kind": "value", "label": "Bias" },
                                { "id": "supply_v", "kind": "value", "label": "Supply" }] },
  "gfx-cab":         { "rows": [], "hide": ["loaded_a", "loaded_b"] },
  "gfx-irfx":        { "rows": [], "hide": ["loaded_a"] },
  "gfx-correct":     { "rows": [{ "id": "state", "kind": "state", "label": "Voice", "states": ["Idle", "Correcting", "Gated"] },
                                { "id": "note", "kind": "value", "label": "Target", "format": "midi" },
                                { "id": "error", "kind": "bar", "label": "Error", "min": -100, "max": 100, "center": true }] },
  "gfx-vocoder":     { "rows": [{ "id": "state", "kind": "lamp", "label": "Gate" },
                                { "id": "f0", "kind": "value", "label": "Pitch" }] },
  "gfx-acoustic":    { "rows": [{ "id": "gr", "kind": "gr", "label": "Comp", "max": 30 }] },
  "gfx-radio":       { "rows": [{ "id": "state", "kind": "lamp", "label": "Keyed" }] },
  "gfx-stretch":     { "rows": [{ "id": "state", "kind": "state", "label": "State", "states": ["Empty", "Capturing", "Playing", "Frozen", "Rolling"] }] },
  "gfx-grains":      { "rows": [{ "id": "state", "kind": "state", "label": "State", "states": ["Live", "Held", "Releasing"] },
                                { "id": "active", "kind": "bar", "label": "Grains", "min": 0, "max": 128 }] },
  "gfx-sustainer":   { "rows": [{ "id": "state", "kind": "state", "label": "Note", "states": ["Idle", "Wait", "Rise", "Hold", "Release"] },
                                { "id": "lock", "kind": "lamp", "label": "Lock" },
                                { "id": "note", "kind": "value", "label": "Pitch" },
                                { "id": "harm", "kind": "value", "label": "Harmonic" }] },
  "gfx-polysynth":   { "rows": [{ "id": "state", "kind": "state", "label": "Synth", "states": ["Silence", "Core", "Voice"] },
                                { "id": "note", "kind": "value", "label": "Pitch" }] },
  "gfx-spectralcomp": { "rows": [{ "id": "gr", "kind": "gr", "label": "Cut", "max": 24 },
                                 { "id": "lift_gr", "kind": "gr", "label": "Lift", "max": 24 },
                                 { "kind": "bands", "label": "Octaves", "ids": ["dyn_63", "dyn_125", "dyn_250", "dyn_500", "dyn_1k", "dyn_2k", "dyn_4k", "dyn_8k"],
                                   "labels": ["63", "125", "250", "500", "1k", "2k", "4k", "8k"], "max": 12 }] },
  "gfx-morph":       { "rows": [{ "id": "state", "kind": "lamp", "label": "Guard" },
                                { "id": "gr", "kind": "gr", "label": "Comp", "max": 24 },
                                { "id": "defizz_gr", "kind": "gr", "label": "De-fizz", "max": 12 }] },
  "gfx-tuner":       { "rows": [{ "id": "state", "kind": "state", "label": "State", "states": ["Silence", "Settling", "Settled", "Strum"] },
                                { "id": "note", "kind": "value", "label": "Note", "format": "midi" },
                                { "id": "cents", "kind": "bar", "label": "Cents", "min": -50, "max": 50, "center": true },
                                { "id": "freq", "kind": "value", "label": "Frequency" },
                                { "kind": "bands", "label": "Strings", "ids": ["s1_cents", "s2_cents", "s3_cents", "s4_cents", "s5_cents", "s6_cents", "s7_cents", "s8_cents"],
                                  "labels": ["1", "2", "3", "4", "5", "6", "7", "8"], "max": 50 }],
                       "hide": ["confidence", "string", "seq", "s1_conf", "s2_conf", "s3_conf", "s4_conf", "s5_conf", "s6_conf", "s7_conf", "s8_conf"] },
  "gfx-formant":     { "rows": [{ "id": "state", "kind": "state", "label": "Voice", "states": ["Held", "Untracked", "Voiced"] }] }
}
